<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ section.title }} – {{ week }}</title></head>
<body style="margin:0;padding:0;background:#f3f5f8;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1c2430;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5f8;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border-radius:12px;overflow:hidden;">
  <tr><td style="background:#1f3a5f;padding:22px 26px;">
    <div style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#a9c1df;">{{ site_title }}</div>
    <div style="font-size:22px;font-weight:600;color:#ffffff;margin-top:4px;">{{ section.title }}</div>
    <div style="font-size:13px;color:#d3e0f0;margin-top:4px;">Semaine {{ week.split('-W')[1] }} · {{ items|length }} info{{ 's' if items|length > 1 }}</div>
  </td></tr>
  {% if not items %}
  <tr><td style="padding:26px;font-size:15px;line-height:1.6;">Semaine calme : aucune information suffisamment solide et récente n'a été retenue pour cette section.</td></tr>
  {% endif %}
  {% for it in items %}
  <tr><td style="padding:22px 26px 6px;{% if not loop.first %}border-top:1px solid #e6eaf0;{% endif %}">
    <span style="display:inline-block;font-size:11px;font-weight:600;background:#e8eef5;color:#1f3a5f;padding:3px 9px;border-radius:10px;">{{ it.tag }}</span>
    <div style="font-size:17px;font-weight:600;line-height:1.35;margin:10px 0 8px;">{{ it.title }}</div>
    <div style="font-size:14px;line-height:1.6;color:#334155;">{{ it.summary }}</div>
    {% if it.note %}
    <div style="margin-top:12px;padding:10px 12px;background:#f0f7f1;border-left:3px solid #2e7d4f;border-radius:4px;font-size:13px;line-height:1.55;color:#1d4d32;"><strong>{{ section.note_label }} :</strong> {{ it.note }}</div>
    {% endif %}
    <div style="margin:14px 0 16px;">
      {% for s in it.sources %}
      <div style="font-size:13px;line-height:1.5;margin-bottom:6px;">
        <span style="display:inline-block;min-width:68px;font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:#64748b;">{{ s.type }}</span>
        <a href="{{ s.url }}" style="color:#1f5fa8;text-decoration:none;">{{ s.title }}</a>
        <span style="color:#94a3b8;font-size:12px;"> · {{ s.domain }}</span>
      </div>
      {% endfor %}
    </div>
  </td></tr>
  {% endfor %}
  {% if page_url %}
  <tr><td style="padding:6px 26px 24px;" align="center">
    <a href="{{ page_url }}" style="display:inline-block;background:#1f3a5f;color:#ffffff;text-decoration:none;font-size:14px;padding:10px 20px;border-radius:8px;">Voir sur le site et l'archive</a>
  </td></tr>
  {% endif %}
  <tr><td style="padding:16px 26px;background:#f8fafc;font-size:11px;line-height:1.5;color:#94a3b8;">
    Récaps générés automatiquement par IA à partir des sources citées : vérifie les sources avant toute action. Domaine de chaque lien affiché en clair.
  </td></tr>
</table></td></tr></table>
</body></html>
